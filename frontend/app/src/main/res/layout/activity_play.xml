<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#000000">

    <include
        android:id="@+id/globalHeaderInclude"
        layout="@layout/layout_global_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp" />

    <androidx.media3.ui.PlayerView
        android:id="@+id/playerView"
        android:layout_width="match_parent"
        android:layout_height="220dp"
        app:use_controller="true"
        app:resize_mode="fit"
        app:hide_on_touch="true"
        app:show_timeout="5000"
        app:show_buffering="when_playing"
        android:background="@android:color/background_dark"
        app:controller_layout_id="@layout/custom_player_control"/>

    <!-- Thông tin phim (cuộn được) -->
    <ScrollView
        android:id="@+id/svInfo"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="8dp">

                <TextView
                    android:id="@+id/tvTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Tên phim"
                    android:textColor="#FFFFFF"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-black"
                    android:padding="8dp"/>

                <ImageButton
                    android:id="@+id/btnFavorite"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:src="@drawable/ic_heart"
                    android:background="@android:color/transparent"
                    android:layout_marginEnd="8dp"/>
            </LinearLayout>

            <!-- Danh sách tập phim -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvEpisodes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="8dp"
                android:layout_marginBottom="16dp"
                android:visibility="gone"/>

            <!-- Khu vực Bình luận -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="8dp">

                <TextView
                    android:id="@+id/tvCommentTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Bình luận (0)"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp"
                    android:paddingStart="8dp"/>

                <!-- Nhập bình luận -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">
                    
                    <ImageView
                        android:id="@+id/ivCurrentUserAvatar"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:src="@drawable/ic_avatar"/>

                    <EditText
                        android:id="@+id/etComment"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="10dp"
                        android:background="@drawable/bg_comment_frame"
                        android:hint="Thêm bình luận..."
                        android:textColorHint="#888888"
                        android:textColor="@android:color/white"
                        android:padding="12dp"
                        android:textSize="14sp"/>

                    <ImageButton
                        android:id="@+id/btnCancelReply"
                        android:layout_width="35dp"
                        android:layout_height="35dp"
                        android:layout_marginStart="8dp"
                        android:src="@drawable/ic_close"
                        android:background="@android:color/transparent"
                        android:visibility="gone"
                        app:tint="#888888" />

                    <ImageButton
                        android:id="@+id/btnSendComment"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_marginStart="10dp"
                        android:background="@drawable/bg_circle_gradient_pink"
                        android:src="@drawable/ic_send"
                        app:tint="@android:color/white"
                        android:padding="10dp"/>
                </LinearLayout>

                <!-- Danh sách bình luận -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvComment"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false" />

                <!-- Nút Tải thêm bình luận -->
                <!-- Phân trang bình luận -->
                <LinearLayout
                    android:id="@+id/layoutPagination"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="16dp"
                    android:visibility="gone">

                    <ImageButton
                        android:id="@+id/btnPrevPage"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="@android:color/transparent"
                        android:src="@drawable/ic_back"
                        app:tint="@android:color/white"/>

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvPagination"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="8dp"/>

                    <ImageButton
                        android:id="@+id/btnNextPage"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="@android:color/transparent"
                        android:src="@drawable/ic_back"
                        android:rotation="180"
                        app:tint="@android:color/white"/>
                </LinearLayout>

            </LinearLayout>

            <!-- Tiêu đề Phim đề xuất -->
            <TextView
                android:id="@+id/tvRecommendedTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Phim đề xuất"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginTop="8dp"
                android:paddingHorizontal="12dp"
                android:paddingBottom="6dp"/>

            <!-- Danh sách phim được đề xuất (dùng poster_genre_item) -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvListMovies"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:clipToPadding="false"
                android:nestedScrollingEnabled="false"
                android:paddingHorizontal="4dp"/>

        </LinearLayout>

    </ScrollView>



</LinearLayout>
