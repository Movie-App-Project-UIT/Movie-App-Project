<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="20dp"
    android:paddingBottom="24dp">

    <!-- Thanh kéo (Drag Handle) ở trên cùng -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center"
        android:layout_marginTop="12dp"
        android:background="#4F526B"
        android:backgroundTint="#4F526B" />

    <!-- Thanh tiêu đề và nút đóng -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp">

        <!-- Nút Close (X) hình tròn bên trái -->
        <ImageView
            android:id="@+id/btnClose"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/bg_circle_close"
            android:contentDescription="Đóng"
            android:padding="8dp"
            android:src="@drawable/ic_close"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Tiêu đề ở chính giữa -->
        <TextView
            android:id="@+id/txtSheetTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tên hiển thị"
            android:textColor="@color/white"
            android:textSize="20sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Icon lớn ở giữa (Icon Profile) -->
    <ImageView
        android:id="@+id/imgSheetIcon"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_gravity="center"
        android:layout_marginTop="24dp"
        android:src="@drawable/ic_profile"
        app:tint="#8B5CF6" />

    <!-- Khoảng cách nhỏ -->
    <View
        android:layout_width="match_parent"
        android:layout_height="20dp" />

    <!-- Ô nhập Tên hiển thị mới -->
    <EditText
        android:id="@+id/edtDisplayName"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginBottom="24dp"
        android:background="@drawable/bg_input_field_dialog"
        android:hint="Nhập tên hiển thị mới"
        android:inputType="textPersonName"
        android:paddingHorizontal="16dp"
        android:textColor="@color/white"
        android:textColorHint="@color/gray_text_light"
        android:textSize="14sp" />

    <!-- Nút Cập nhật tên hiển thị -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnSubmitName"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:background="@drawable/bg_gradient_save_button"
        android:text="Lưu"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:textSize="16sp"
        android:textStyle="bold" />

</LinearLayout>
