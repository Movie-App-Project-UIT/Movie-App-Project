<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_dropdown"
    android:padding="16dp">

    <!-- Header -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Thông báo"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_alignParentStart="true"/>

        <TextView
            android:id="@+id/tvMarkAsRead"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Đánh dấu đã đọc"
            android:textColor="@color/purple_accent"
            android:textSize="14sp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"/>
    </RelativeLayout>

    <!-- Empty State -->
    <LinearLayout
        android:id="@+id/layoutEmptyNotification"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingVertical="24dp">

        <ImageView
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:src="@drawable/notification_none" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Bạn chưa có thông báo nào"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginTop="16dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Khi có thông báo mới, chúng tôi\nsẽ thông báo cho bạn tại đây."
            android:textColor="@color/gray_text_light"
            android:textSize="14sp"
            android:textAlignment="center"
            android:layout_marginTop="8dp"/>
    </LinearLayout>

    <!-- Danh sách thông báo (Ẩn đi khi trống) -->
    <LinearLayout
        android:id="@+id/layoutNotificationList"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- Thông báo 1: Admin tặng Premium -->
        <LinearLayout
            android:id="@+id/layoutNotifAdminGift"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:paddingVertical="12dp">

            <!-- Dấu chấm & Icon -->
            <RelativeLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <View
                    android:id="@+id/dotUnreadAdminGift"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:layout_centerVertical="true"
                    android:background="@drawable/bg_circle_dot"/>
                <ImageView
                    android:id="@+id/ivGiftIcon"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:layout_toEndOf="@id/dotUnreadAdminGift"
                    android:layout_marginStart="8dp"
                    android:src="@drawable/ic_gift"
                    android:background="@drawable/bg_gift_icon"
                    android:padding="12dp"
                    app:tint="@color/white"/>
            </RelativeLayout>

            <!-- Nội dung bên phải -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp">

                <!-- Text Nội dung -->
                <LinearLayout
                    android:id="@+id/llTextContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_toStartOf="@+id/ivChevron"
                    android:layout_marginEnd="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Quà tặng từ Admin"
                        android:textColor="@color/white"
                        android:textSize="15sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Bạn nhận được 7 ngày\nPremium miễn phí."
                        android:textColor="@color/gray_text_light"
                        android:textSize="13sp"
                        android:layout_marginTop="2dp"
                        android:lineSpacingExtra="2dp"/>

                    <TextView
                        android:id="@+id/tvAdminGiftTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="1 giờ trước"
                        android:textColor="#888888"
                        android:textSize="12sp"
                        android:layout_marginTop="4dp"/>
                </LinearLayout>

                <!-- Mũi tên -->
                <ImageView
                    android:id="@+id/ivChevron"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_alignParentEnd="true"
                    android:src="@drawable/ic_chevron_right"
                    app:tint="#666666"/>

                <!-- Nút Kích hoạt -->
                <TextView
                    android:id="@+id/btnActivateGift"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/llTextContent"
                    android:layout_alignParentEnd="true"
                    android:layout_marginTop="8dp"
                    android:text="Kích hoạt"
                    android:textColor="#B39DFF"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_button_activate"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="6dp"/>
            </RelativeLayout>
        </LinearLayout>

        <View
            android:id="@+id/dividerDropdown"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#33FFFFFF"
            android:layout_marginVertical="8dp"
            android:visibility="gone"/>

        <!-- Thông báo 2: Nâng cấp thành công -->
        <LinearLayout
            android:id="@+id/layoutNotifSuccess"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp"
            android:clickable="true"
            android:focusable="true">

            <!-- Dấu chấm chưa đọc (Bên trái ngoài cùng) -->
            <View
                android:id="@+id/dotUnreadSuccess"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_marginTop="32dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_circle_dot"
                android:backgroundTint="@color/purple_accent"/>

            <!-- Khung thông báo chính -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_plan_info_card"
                android:padding="16dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <!-- Icon -->
                    <ImageView
                        android:id="@+id/ivSuccessIcon"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:background="@drawable/bg_circle_gradient"
                        android:padding="12dp"
                        android:src="@drawable/ic_crown"
                        app:tint="@color/white" />

                    <!-- Nội dung chữ -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_toEndOf="@id/ivSuccessIcon"
                        android:layout_marginStart="12dp">

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">
                            
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentStart="true"
                                android:layout_toStartOf="@+id/tvBadgeNewDropdown"
                                android:layout_marginEnd="8dp"
                                android:text="Nâng cấp thành công"
                                android:textColor="@color/white"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                            <!-- Badge Mới -->
                            <TextView
                                android:id="@+id/tvBadgeNewDropdown"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentEnd="true"
                                android:background="@drawable/bg_button_outline"
                                android:paddingHorizontal="8dp"
                                android:paddingVertical="2dp"
                                android:text="Mới"
                                android:textColor="#B39DFF"
                                android:textSize="10sp" />
                        </RelativeLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:lineSpacingExtra="2dp"
                            android:text="Chào mừng bạn đến với Premium! Bạn đã mở khóa tất cả đặc quyền xem phim."
                            android:textColor="@color/gray_text_light"
                            android:textSize="13sp" />

                        <!-- Footer (Time + Button) -->
                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp">

                            <TextView
                                android:id="@+id/tvSuccessTime"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_centerVertical="true"
                                android:text="Vừa xong"
                                android:textColor="#888888"
                                android:textSize="12sp" />

                            <!-- Nút hành động -->
                            <TextView
                                android:id="@+id/btnViewPrivileges"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentEnd="true"
                                android:layout_centerVertical="true"
                                android:background="@drawable/bg_button_activate"
                                android:paddingHorizontal="16dp"
                                android:paddingVertical="6dp"
                                android:text="Xem đặc quyền"
                                android:textColor="#B39DFF"
                                android:textSize="12sp"
                                android:textStyle="bold"/>

                        </RelativeLayout>
                    </LinearLayout>
                </RelativeLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Footer -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#33FFFFFF"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="12dp"/>

    <LinearLayout
        android:id="@+id/btnViewAllNotifications"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:paddingVertical="4dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Xem tất cả thông báo"
            android:textColor="@color/purple_accent"
            android:textSize="14sp"/>

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_chevron_right"
            app:tint="@color/purple_accent"
            android:layout_marginStart="4dp"/>
    </LinearLayout>

</LinearLayout>
