<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#050814"
    tools:context=".ui.main.FavoriteActivity">

    <!-- Tiêu đề -->
    <TextView
        android:id="@+id/tvHeaderFav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Danh sách phim yêu thích"
        android:textSize="20sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginTop="12dp"
        android:textColor="@android:color/white"/>

    <!-- Đường gradient -->
    <View
        android:id="@+id/view"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="15dp"
        android:layout_marginBottom="2dp"
        android:background="@drawable/bg_gradient_save_button"/>

    <!-- Số lượng phim -->
    <TextView
        android:id="@+id/tvCountMovieFav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="16 phim"
        android:layout_marginStart="10dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="5dp"
        android:textColor="@color/white"/>

    <!-- Danh sách poster -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvFav"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="8dp"
        android:clipToPadding="false"/>

    <!-- Bottom nav -->
    <include
        layout="@layout/layout_bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="80dp"/>
</LinearLayout>
