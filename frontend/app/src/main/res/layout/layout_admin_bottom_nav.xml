<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/adminBottomNavContainer"
    android:layout_width="match_parent"
    android:layout_height="80dp"
    android:background="@drawable/bg_bottom_nav"
    android:elevation="8dp">

    <LinearLayout
        android:id="@+id/adminBottomNav"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingTop="15dp">

        <ImageButton
            android:id="@+id/btnAdminDashboard"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:src="@drawable/ic_home"
            app:tint="@color/btn_nav_selector"
            android:elevation="8dp"/>

        <ImageButton
            android:id="@+id/btnAdminSubscriptions"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:src="@drawable/ic_crown"
            app:tint="@color/btn_nav_selector"
            android:elevation="8dp"/>

        <ImageButton
            android:id="@+id/btnAdminUsers"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:src="@drawable/ic_profile"
            app:tint="@color/btn_nav_selector"
            android:elevation="8dp"/>

        <ImageButton
            android:id="@+id/btnAdminProfile"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:src="@drawable/ic_shield"
            app:tint="@color/btn_nav_selector"
            android:elevation="8dp"/>

    </LinearLayout>
</FrameLayout>
