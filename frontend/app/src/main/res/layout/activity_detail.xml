<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#050814">

    <LinearLayout
        android:id="@+id/headerBanner"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent">

    <FrameLayout
        android:id="@+id/ImagePoster"
        android:layout_width="match_parent"
        android:layout_height="300dp"
        android:background="@drawable/nen"
        android:foreground="?attr/selectableItemBackgroundBorderless"
        android:elevation="8dp"
        android:outlineProvider="background">

        <ImageView
            android:id="@+id/ivBackdrop"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/headedetail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp">

            <TextView
                android:id="@+id/txt_IMDb"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="IMDb 9.0"
                android:textColor="@android:color/white"
                android:padding="4dp"
                android:background="@drawable/bg_text"
                android:textSize="14sp"
                android:layout_marginLeft="20dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/txt_VIP"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="VIP"
                android:textColor="#F1D30E"
                android:padding="5dp"
                android:background="@drawable/bg_text"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginRight="20dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </FrameLayout>


    <ImageButton
        android:id="@+id/btnPlayDetail"
        android:layout_width="50dp"
        android:layout_height="55dp"
        android:elevation="10dp"
        android:layout_marginEnd="45dp"
        android:background="@android:color/transparent"
        android:src="@drawable/ic_play_detail"
        android:layout_gravity="end"
        android:layout_marginTop="-40dp"/>
    </LinearLayout>

    <!--Fragment cho bình luận và đánh giá-->
    <FrameLayout
        android:id="@+id/detailFragmentContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/headerBanner"
        app:layout_constraintBottom_toBottomOf="parent"/>

    <ScrollView
        android:id="@+id/svInfo"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/headerBanner">

        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!--Thông tin phim-->
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical">

                <TextView
                    android:id="@+id/tvTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Your Name"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:textColor="@android:color/white"
                    android:fontFamily="@font/playfair"
                    android:layout_marginLeft="15dp"
                    android:layout_marginRight="10dp"/>

                <TextView
                    android:id="@+id/tvYear"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="2016"
                    android:textSize="14sp"
                    android:textColor="#BCBFC4"/>

            </LinearLayout>

            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_marginTop="8dp">

                <TextView
                    android:id="@+id/tvStartRanking"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="4.5/5"
                    android:textColor="@android:color/white"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:layout_marginLeft="15dp"/>

                <ImageView
                    android:src="@drawable/start"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginStart="4dp"/>

                <TextView
                    android:id="@+id/tvDuration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="2h 45m"
                    android:textSize="14sp"
                    android:layout_marginStart="35dp"
                    android:textColor="#BCBFC4"/>

                <TextView
                    android:id="@+id/tvView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="100 lượt xem"
                    android:textSize="14sp"
                    android:layout_marginStart="35dp"
                    android:textColor="#BCBFC4"/>
            </LinearLayout>

            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="15dp"
                    android:text="Thể loại:"
                    android:textStyle="bold"
                    android:textColor="@android:color/white"
                    android:textSize="14sp"/>

                <TextView
                    android:id="@+id/tvMediaType"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:text="Học đường"
                    android:textColor="#BCBFC4"
                    android:textSize="14sp"/>
            </LinearLayout>

            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="15dp"
                    android:text="Quốc gia:"
                    android:textStyle="bold"
                    android:textColor="@android:color/white"
                    android:textSize="14sp"/>

                <TextView
                    android:id="@+id/tvCountry"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:text="Nhật bản"
                    android:textColor="#BCBFC4"
                    android:textSize="14sp"/>
            </LinearLayout>

            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="15dp"
                    android:text="Ngôn ngữ:"
                    android:textStyle="bold"
                    android:textColor="@android:color/white"
                    android:textSize="14sp"/>

                <TextView
                    android:id="@+id/tvGenre"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:text="Tiếng Việt"
                    android:textColor="#BCBFC4"
                    android:textSize="14sp"/>
            </LinearLayout>

            <TextView
                android:id="@+id/tvDesc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginStart="15dp"
                android:layout_marginEnd="15dp"
                android:text="Mitsuha, một nữ sinh sống ở vùng quê yên bình, và Taki, một nam sinh ở Tokyo, bất ngờ hoán đổi cơ thể cho nhau một cách bí ẩn. Khi dần quen với cuộc sống của đối phương, cả hai bắt đầu hình thành một mối liên kết đặc biệt vượt qua khoảng cách không gian và thời gian. Hành trình tìm kiếm nhau hé lộ những bí mật cảm động về định mệnh, ký ức và tình yêu."
                android:textColor="#BABABA"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@drawable/bg_gradient_save_button"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="2dp"/>

            <!--Tab yêu thích + bình luận + đánh giá-->
            <include
                layout="@layout/layout_detail_action"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"/>

            <!--2 tab hiển thị mặc định là "Gợi ý tương tự" nếu là phim bộ thì hiển thị "Tập phim" còn không thì bỏ qua-->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="10dp">

                        <!-- Tabs -->
                        <LinearLayout
                            android:id="@+id/tabContainer"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center">

                            <TextView
                                android:id="@+id/tabSuggestion"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:paddingHorizontal="20dp"
                                android:paddingVertical="8dp"
                                android:text="Gợi ý tương tự"
                                android:textColor="@color/white"
                                android:textSize="16sp" />

                            <TextView
                                android:id="@+id/tabEpisode"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Tập phim"
                                android:textColor="@color/white"
                                android:textSize="16sp"
                                android:paddingHorizontal="20dp"
                                android:paddingVertical="8dp"/>
                        </LinearLayout>

                        <!-- Thanh trượt dưới tab -->
                        <View
                            android:id="@+id/tabIndicator"
                            android:layout_width="100dp"
                            android:layout_height="2dp"
                            android:layout_marginTop="4dp"
                            android:background="@drawable/bg_gradient_save_button"
                            android:layout_gravity="start"/>

                <!-- Nội dung thay đổi -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>