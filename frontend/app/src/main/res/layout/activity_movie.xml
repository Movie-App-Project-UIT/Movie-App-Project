<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#050814">

    <!-- Nội dung chính: thanh tìm kiếm + bộ lọc + danh sách -->
    <LinearLayout
        android:id="@+id/layoutContent"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:padding="12dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottomNavInclude">

        <!-- Thanh tìm kiếm -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/bg_input_field"
            android:gravity="center_vertical"
            android:paddingHorizontal="12dp">
            
            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_search"
                app:tint="#AAAAAA"/>

            <EditText
                android:id="@+id/edtSearch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Tìm kiếm trên PeMo"
                android:textSize="14sp"
                android:background="@null"
                android:paddingVertical="10dp"
                android:paddingStart="8dp"
                android:textColorHint="#AAAAAA"
                android:textColor="#FFFFFF"/>
        </LinearLayout>

        <!-- TabLayout cho Định dạng phim -->
        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tabLayoutMediaType"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@android:color/transparent"
            app:tabIndicator="@drawable/bg_gradient_save_button"
            app:tabSelectedTextColor="#9D2DBE"
            app:tabTextColor="#BDBDBD">
            
            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tất cả" />
            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Phim Lẻ" />
            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Phim Bộ" />
        </com.google.android.material.tabs.TabLayout>

        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#333333" />

        <!-- Nút Mở rộng bộ lọc và Sắp xếp -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="12dp">
            
            <!-- Nút Mở rộng bộ lọc -->
            <LinearLayout
                android:id="@+id/btnToggleFilter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_alignParentStart="true"
                android:clickable="true"
                android:focusable="true">
                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_search"
                    app:tint="#BDBDBD" />
                <TextView
                    android:id="@+id/txtToggleFilter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Mở rộng bộ lọc"
                    android:textColor="#BDBDBD"
                    android:layout_marginStart="8dp"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- Sắp xếp -->
            <LinearLayout
                android:id="@+id/btnSortOptions"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_alignParentEnd="true"
                android:clickable="true"
                android:focusable="true">
                <TextView
                    android:id="@+id/txtCurrentSort"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sắp xếp: Mới nhất"
                    android:textColor="#D70466"
                    android:textSize="14sp" />
                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_chevron_right"
                    android:rotation="90"
                    app:tint="#D70466"
                    android:layout_marginStart="4dp"/>
            </LinearLayout>
        </RelativeLayout>

        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#333333" />

        <!-- Container chứa các cuộn ngang -->
        <LinearLayout
            android:id="@+id/layoutFiltersContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:paddingTop="12dp">
            
            <!-- Hàng: Khu vực -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="8dp">
                <TextView android:layout_width="90dp" android:layout_height="wrap_content" android:text="Quốc gia:" android:textColor="#888888" android:textSize="13sp"/>
                <androidx.recyclerview.widget.RecyclerView android:id="@+id/rvCountries" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="horizontal" app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />
            </LinearLayout>

            <!-- Hàng: Thể loại -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="8dp">
                <TextView android:layout_width="90dp" android:layout_height="wrap_content" android:text="Thể loại:" android:textColor="#888888" android:textSize="13sp"/>
                <androidx.recyclerview.widget.RecyclerView android:id="@+id/rvGenres" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="horizontal" app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />
            </LinearLayout>

            <!-- Hàng: Độ tuổi (Đã ẩn) -->
            <!--
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="8dp">
                <TextView android:layout_width="90dp" android:layout_height="wrap_content" android:text="Độ tuổi:" android:textColor="#888888" android:textSize="13sp"/>
                <androidx.recyclerview.widget.RecyclerView android:id="@+id/rvAgeRatings" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="horizontal" app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />
            </LinearLayout>
            -->

            <!-- Hàng: Thập niên -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="8dp">
                <TextView android:layout_width="90dp" android:layout_height="wrap_content" android:text="Năm phát hành:" android:textColor="#888888" android:textSize="13sp"/>
                <androidx.recyclerview.widget.RecyclerView android:id="@+id/rvYears" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="horizontal" app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />
            </LinearLayout>
            
            <!-- Sắp xếp đã được dời ra ngoài -->
        </LinearLayout>

        <!-- Danh sách phim -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvMovies"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:paddingTop="16dp"
            android:clipToPadding="false"
            android:paddingBottom="20dp" />
    </LinearLayout>

    <include
        android:id="@+id/bottomNavInclude"
        layout="@layout/layout_bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
